# QuLabInfinite sample environment configuration
# Replace all sample values before running any server.

# Required: comma-separated list of secure API keys shared across the gateway and routers
QU_LAB_MASTER_KEYS="replace-with-strong-key-1,replace-with-strong-key-2"

# Optional: Stitch Data API key (server-side only; for aios.is website metrics/dashboards)
# Get from Stitch account → API keys. Never expose in frontend.
# STITCH_API_KEY=your_stitch_api_key_here

# Roof Hunter / BatchData lead generation
# Get API key from https://app.batchdata.com → API Keys
# BATCHDATA_API_KEY=your_batchdata_api_key_here

# Optional: customize tiers and rate limits (must be positive integers)
QU_LAB_MASTER_TIER=enterprise
QU_LAB_MASTER_RATE_LIMIT=1000
QU_LAB_KEY_TIER=custom
QU_LAB_RATE_LIMIT=1000
