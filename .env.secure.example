# QuLabInfinite Secure Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# SECURITY - REQUIRED FOR PRODUCTION
# ============================================================================

# JWT Secret Key (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_STRING_MINIMUM_32_CHARS

# API Key Salt (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEY_SALT=REPLACE_WITH_SECURE_RANDOM_STRING_MINIMUM_32_CHARS

# Session Secret (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MINIMUM_32_CHARS

# ============================================================================
# MATERIALS PROJECT API
# ============================================================================
# Get your free API key at: https://materialsproject.org/api
# Required for accessing Materials Project database (140K+ materials)
MP_API_KEY=your_materials_project_api_key_here

# ============================================================================
# OPTIONAL INTEGRATIONS
# ============================================================================

# Supabase Main Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# OpenAI API (for ML-powered property predictions)
OPENAI_API_KEY=your_openai_key_here

# Quantum computing services (if using real quantum hardware)
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# Twilio (for notifications/SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Connection
DATABASE_URL=postgresql://user:password@localhost:5432/qulabinfinite
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment (development, staging, production)
QULAB_ENV=development

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# API Workers (for uvicorn)
WORKERS=4

# Enable debug mode (NEVER use in production)
DEBUG=false

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Cache directory for Materials Project data
MP_CACHE_DIR=./mp_cache

# Maximum parallel API requests
MAX_PARALLEL_REQUESTS=5

# API rate limit (requests per second)
API_RATE_LIMIT=5

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ============================================================================
# SIMULATION SETTINGS
# ============================================================================

# Default number of simulation points
DEFAULT_SIMULATION_POINTS=1000

# Enable GPU acceleration (if available)
USE_GPU=false

# Number of CPU cores to use (0 = auto)
NUM_CORES=0

# Maximum memory per simulation (GB)
MAX_MEMORY_GB=8

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# API key expiration (days, 0 = never)
API_KEY_EXPIRE_DAYS=0

# Password minimum length
PASSWORD_MIN_LENGTH=8

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration (minutes)
LOCKOUT_DURATION_MINUTES=30

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Sentry DSN (for error tracking)
SENTRY_DSN=your_sentry_dsn_here

# Prometheus metrics port
METRICS_PORT=9090

# Enable distributed tracing
ENABLE_TRACING=false

# Jaeger agent host
JAEGER_AGENT_HOST=localhost

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable experimental features
ENABLE_EXPERIMENTAL=false

# Enable heavy computational tests
QULAB_RUN_HEAVY_TESTS=0

# Enable quantum hardware integration
ENABLE_QUANTUM_HARDWARE=false

# Enable ML property prediction
ENABLE_ML_PREDICTION=false
